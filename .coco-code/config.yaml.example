providers:
  - name: anthropic-official
    protocol: anthropic
    base_url: https://api.anthropic.com
    api_key: "your-api-key-here"
    model: claude-sonnet-4-20250514
    thinking: true

  # OpenAI provider example
  # - name: openai-official
  #   protocol: openai
  #   base_url: https://api.openai.com/v1
  #   api_key: "your-api-key-here"
  #   api_key_env: OPENAI_API_KEY
  #   model: gpt-4o

permission_mode: default

mcp_servers:
  - name: context7
    command: npx
    args: ["-y", "@upstash/context7-mcp"]

  # Streamable HTTP example (2025-03-26 spec, default when url is set):
  # - name: my-http-mcp
  #   url: https://example.com/mcp
  #   transport: http   # optional; "http" (default) or "sse"
  #   headers:
  #     Authorization: "Bearer ${MY_TOKEN}"

# Deterministic post-edit verification gate. Explicit commands take priority;
# with an empty list CoCo conservatively discovers common root-level test suites.
verification:
  enabled: true
  auto_discover: true
  commands: []
  timeout_seconds: 300
  max_fix_attempts: 2
  fail_fast: true
  output_limit: 12000

enable_coordinator_mode: false   # 设为 true 后创建 Team 时 Lead 只能调度不能写代码
